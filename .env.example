# Server
PORT=5100

# JWT / password hashing
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRING_TIME=1h
SALT_ROUNDS=10

# Managed (Aiven) PostgreSQL connection for development & production.
# Preferred: a single connection URL. Requires TLS; certificate verification
# stays enabled (rejectUnauthorized: true).
DATABASE_URL=postgresql://user:password@host.aivencloud.com:port/database?sslmode=require

# Aiven TLS. SSL_MODE documents the service mode; the CA below is trusted for
# certificate verification. Paste the service CA (ca.pem) here.
SSL_MODE=require
CAC=-----BEGIN CERTIFICATE-----
...replace-with-the-aiven-ca-certificate-body...
-----END CERTIFICATE-----

# Component-based fallback (used only when DATABASE_URL is unset). These must
# describe the same Aiven instance; there is no localhost fallback.
DB_HOST=host.aivencloud.com
DB_PORT=5432
DB_USER=user
DB_PASSWORD=replace-with-your-password
DB_NAME=database

# Isolated test database. The test environment ignores DATABASE_URL and the
# managed DB_* values above, so tests never touch Aiven.
DB_HOST_TEST=127.0.0.1
DB_PORT_TEST=5432
DB_USER_TEST=postgres
DB_PASSWORD_TEST=replace-with-your-test-password
DB_NAME_TEST=banking_test
DB_SSL_TEST=false
